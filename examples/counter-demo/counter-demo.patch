diff --git a/src/model/counter_store.h b/src/model/counter_store.h
new file mode 100644
index 0000000..94305ee
--- /dev/null
+++ b/src/model/counter_store.h
@@ -0,0 +1,77 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#include <charconv>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+
+namespace model {
+
+constexpr int kMaxCount = 9999;
+
+inline std::filesystem::path counter_state_path() {
+    if (const char* xdg = std::getenv("XDG_STATE_HOME")) {
+        const std::filesystem::path base(xdg);
+        if (base.is_absolute()) {
+            return base / "cp0-guide-counter-demo" / "count";
+        }
+    }
+    if (const char* home = std::getenv("HOME")) {
+        const std::filesystem::path base(home);
+        if (base.is_absolute()) {
+            return base / ".local/state/cp0-guide-counter-demo/count";
+        }
+    }
+    return {};
+}
+
+inline int load_count(const std::filesystem::path& path) {
+    std::ifstream input(path);
+    char text[8]{};
+    if (!input.getline(text, sizeof(text))) {
+        return 0;
+    }
+    const auto length = input.gcount() - (input.eof() ? 0 : 1);
+    if (length <= 0 || input.peek() != std::char_traits<char>::eof()) {
+        return 0;
+    }
+    int result = 0;
+    const auto parsed = std::from_chars(text, text + length, result);
+    return parsed.ec == std::errc{} && parsed.ptr == text + length &&
+           result >= 0 && result <= kMaxCount ? result : 0;
+}
+
+inline bool save_count(const std::filesystem::path& path, int count) {
+    if (path.empty() || count < 0 || count > kMaxCount) {
+        return false;
+    }
+    std::error_code error;
+    std::filesystem::create_directories(path.parent_path(), error);
+    if (error) {
+        return false;
+    }
+    // A same-directory rename keeps a complete old or new file across ordinary
+    // restarts. This demo is single-instance; it does not promise power-loss durability.
+    auto temp = path;
+    temp += ".tmp";
+    std::ofstream output(temp, std::ios::trunc);
+    if (!output) {
+        return false;
+    }
+    output << count << '\n';
+    output.close();
+    if (output) {
+        std::filesystem::rename(temp, path, error);
+        if (!error) {
+            return true;
+        }
+    }
+    std::filesystem::remove(temp, error);
+    return false;
+}
+
+} // namespace model
