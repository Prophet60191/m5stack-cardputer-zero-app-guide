+void BaseViewModel::change_count(int delta) {
+    const auto next = std::clamp(counter_subject_.value() + delta, 0, model::kMaxCount);
+    if (next == counter_subject_.value()) {
+        return;
+    }
+    if (model::save_count(model::counter_state_path(), next)) {
+        counter_subject_.set(next);
+        save_status_subject_.set("Saved");
+    } else {
+        save_status_subject_.set("Not saved: check state folder");
+    }
