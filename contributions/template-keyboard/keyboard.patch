+// SPDX-License-Identifier: MIT
+#include "keyboard_editor.h"
+
+namespace examples {
+lv_obj_t* make_keyboard_editor(lv_obj_t* parent) {
+    auto* editor = lv_textarea_create(parent);
+    lv_textarea_set_one_line(editor, true);
+    // A self-contained high-contrast field in either parent theme.
+    lv_obj_set_style_bg_color(editor, lv_color_white(), 0);
+    lv_obj_set_style_text_color(editor, lv_color_black(), 0);
+    lv_textarea_set_max_length(editor, 64);
+    lv_textarea_set_placeholder_text(editor, "Type here: Sym+N = /");
+    lv_obj_set_size(editor, LV_PCT(94), 36);
+    lv_obj_align(editor, LV_ALIGN_CENTER, 0, 0);
+    if (auto* group = lv_group_get_default()) {
+        lv_group_add_obj(group, editor);
+        lv_group_focus_obj(editor);
+    }
+    auto* hint = lv_label_create(parent);
+    lv_label_set_text(hint, "Tab: controls | Esc: back");
+    lv_obj_align(hint, LV_ALIGN_BOTTOM_MID, 0, -1);
+    return editor;
+}
+}
